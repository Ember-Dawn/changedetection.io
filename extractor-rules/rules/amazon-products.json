{
  "schema_version": 1,
  "id": "amazon-products",
  "name": "Amazon Products",
  "enabled": true,
  "page": {
    "extra_wait_seconds": 3
  },
  "match": {
    "domains": [
      "amazon.com"
    ],
    "path_patterns": [
      "*/dp/*",
      "*/gp/product/*"
    ]
  },
  "fields": {
    "price": {
      "selectors": [
        {
          "type": "css",
          "value": "#newAccordionRow_0 .a-price.apex-pricetopay-value:not(.priceToPay) > .a-offscreen",
          "extract": "text"
        },
        {
          "type": "css",
          "value": "#gsod_singleOfferDisplay_Desktop .a-price.apex-pricetopay-value:not(.priceToPay) > .a-offscreen",
          "extract": "text"
        }
      ]
    },
    "currency": {
      "literal": "USD"
    },
    "title": {
      "selectors": [
        {
          "type": "css",
          "value": "#title #productTitle",
          "extract": "text"
        }
      ]
    },
    "sku": {
      "selectors": [
        {
          "type": "xpath",
          "value": "//form[@id='addToCart']//input[@id='ASIN']/@value"
        }
      ]
    },
    "shipping": {
      "condition": {
        "op": "coalesce",
        "items": [
          {
            "op": "all",
            "items": [
              {
                "op": "exists",
                "selector": {
                  "type": "css",
                  "value": "#newAccordionRow_0 #availability .primary-availability-message"
                },
                "guard": {
                  "type": "css",
                  "value": "#newAccordionRow_0 #outOfStock, #newAccordionRow_0 #availability .primary-availability-message"
                }
              },
              {
                "op": "exists",
                "selector": {
                  "type": "css",
                  "value": "#newAccordionRow_0 #add-to-cart-button"
                },
                "guard": {
                  "type": "css",
                  "value": "#newAccordionRow_0 #outOfStock, #newAccordionRow_0 #availability .primary-availability-message"
                }
              },
              {
                "op": "exists",
                "selector": {
                  "type": "css",
                  "value": "#newAccordionRow_0 #deliveryBlockMessage"
                },
                "guard": {
                  "type": "css",
                  "value": "#newAccordionRow_0 #outOfStock, #newAccordionRow_0 #availability .primary-availability-message"
                }
              }
            ]
          },
          {
            "op": "all",
            "items": [
              {
                "op": "exists",
                "selector": {
                  "type": "css",
                  "value": "#gsod_singleOfferDisplay_Desktop #availability .primary-availability-message"
                },
                "guard": {
                  "type": "css",
                  "value": "#outOfStock, #gsod_singleOfferDisplay_Desktop #availability .primary-availability-message"
                }
              },
              {
                "op": "exists",
                "selector": {
                  "type": "css",
                  "value": "#gsod_singleOfferDisplay_Desktop #add-to-cart-button"
                },
                "guard": {
                  "type": "css",
                  "value": "#outOfStock, #gsod_singleOfferDisplay_Desktop #availability .primary-availability-message"
                }
              },
              {
                "op": "exists",
                "selector": {
                  "type": "css",
                  "value": "#gsod_singleOfferDisplay_Desktop #deliveryBlockMessage"
                },
                "guard": {
                  "type": "css",
                  "value": "#outOfStock, #gsod_singleOfferDisplay_Desktop #availability .primary-availability-message"
                }
              }
            ]
          }
        ]
      }
    },
    "in_stock": {
      "condition": {
        "op": "ref",
        "field": "shipping"
      }
    }
  }
}
