{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/changedetection/product-rule.schema.json",
  "title": "Declarative product extraction rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "match",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "match": {
      "type": "object",
      "required": [
        "domains"
      ],
      "additionalProperties": false,
      "properties": {
        "domains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "string"
          }
        },
        "path_patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": {
        "enum": [
          "price",
          "currency",
          "in_stock",
          "stock_quantity",
          "title",
          "sku",
          "pickup",
          "shipping"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/field"
      },
      "properties": {
        "currency": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "literal"
              ],
              "properties": {
                "literal": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$",
                  "description": "Recognized ISO 4217 currency code (validated by server)."
                }
              }
            },
            {
              "$ref": "#/$defs/field"
            }
          ]
        }
      }
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extra_wait_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30,
          "description": "Additional seconds after page navigation, before extracting HTML and screenshot."
        }
      }
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "enum": [
            "css",
            "xpath",
            "jsonpath",
            "regex"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "extract": {
          "enum": [
            "text",
            "html",
            "value",
            "attr"
          ]
        },
        "attribute": {
          "type": "string"
        }
      }
    },
    "field": {
      "type": "object",
      "properties": {
        "selectors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/selector"
          }
        },
        "type": {
          "enum": [
            "css",
            "xpath",
            "jsonpath",
            "regex"
          ]
        },
        "value": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "extract": {
          "enum": [
            "text",
            "html",
            "value",
            "attr"
          ]
        },
        "attribute": {
          "type": "string"
        },
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "in_stock": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "out_of_stock": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unknown": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "condition": {
          "$ref": "#/$defs/condition"
        }
      },
      "not": {
        "required": [
          "literal"
        ]
      }
    },
    "condition": {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "enum": [
            "exists",
            "contains",
            "equals",
            "ref",
            "any",
            "all",
            "not",
            "if",
            "coalesce",
            "literal"
          ]
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "guard": {
          "$ref": "#/$defs/selector"
        },
        "value": {},
        "field": {
          "enum": [
            "pickup",
            "shipping",
            "in_stock"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "item": {
          "$ref": "#/$defs/condition"
        },
        "test": {
          "$ref": "#/$defs/condition"
        },
        "then": {
          "$ref": "#/$defs/condition"
        },
        "else": {
          "$ref": "#/$defs/condition"
        }
      },
      "additionalProperties": false
    }
  }
}
