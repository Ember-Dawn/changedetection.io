{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/changedetection/product-rule.schema.json",
  "title": "Declarative product extraction rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "match",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "match": {
      "type": "object",
      "required": [
        "domains"
      ],
      "additionalProperties": false,
      "properties": {
        "domains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "string"
          }
        },
        "path_patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 6,
      "propertyNames": {
        "enum": [
          "price",
          "currency",
          "in_stock",
          "stock_quantity",
          "title",
          "sku"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/field"
      }
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "enum": [
            "css",
            "xpath",
            "jsonpath",
            "regex"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "extract": {
          "enum": [
            "text",
            "html",
            "value",
            "attr"
          ]
        },
        "attribute": {
          "type": "string"
        }
      }
    },
    "field": {
      "type": "object",
      "properties": {
        "selectors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/selector"
          }
        },
        "type": {
          "enum": [
            "css",
            "xpath",
            "jsonpath",
            "regex"
          ]
        },
        "value": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "extract": {
          "enum": [
            "text",
            "html",
            "value",
            "attr"
          ]
        },
        "attribute": {
          "type": "string"
        },
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "in_stock": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "out_of_stock": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unknown": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
