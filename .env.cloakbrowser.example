# Copy to .env if not already present. Never commit .env.
CLOAKBROWSER_LICENSE_KEY=cb_REPLACE_WITH_YOUR_KEY

# Host WebUI port; internal container port remains 5000.
# Published on all host interfaces by the Compose port mapping; protect with a firewall and password.
CHANGEDETECTION_PORT=9901

# Maximum simultaneous watch worker jobs (not browser instances).
FETCH_WORKERS=4

# Maximum simultaneous shared-browser tabs, including previews.
CLOAKBROWSER_MAX_PAGES=4

# Recovery for ordinary browser launch errors.
CLOAKBROWSER_RECOVERY_MAX_RETRIES=3
CLOAKBROWSER_RECOVERY_INITIAL_DELAY=2

# Add Watch previews do not add a separate challenge wait.
# Formal shared-browser fetches use the upstream/per-watch extraction delay.

# Shared desktop viewport for scheduled Watches, live Dry Run and manual fixed mode
CLOAKBROWSER_VIEWPORT_WIDTH=1366
CLOAKBROWSER_VIEWPORT_HEIGHT=900
